# ─────────────────────────────────────────────────────────────────
# Configuração do banco de dados — Zika Dashboard
# Copie este arquivo para .env e preencha com suas credenciais
# ─────────────────────────────────────────────────────────────────

# Opção 1: URL completa (prioridade)
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host/banco?sslmode=require

# Opção 2: Variáveis separadas (NeonDB / Supabase / PostgreSQL)
PGUSER=seu_usuario
PGPASSWORD=sua_senha
PGHOST=seu-host.neon.tech
PGDATABASE=nome_do_banco
PGSSLMODE=require
